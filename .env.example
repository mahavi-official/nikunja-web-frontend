# ─────────────────────────────────────────────────────────────
# Radhakundah frontend
# ─────────────────────────────────────────────────────────────

# Public API base, as the browser sees it (no trailing slash, no /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Same API as the server sees it. In production this can be an internal
# address so SSR never leaves the private network. Falls back to the public one.
API_INTERNAL_URL=http://localhost:4000

# Canonical site origin. Every absolute URL we emit is built from this.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CDN in front of the public media bucket, added to next/image remotePatterns.
NEXT_PUBLIC_CDN_URL=https://cdn.radhakundah.com

# "true" only on the production deployment. Anything else serves
# robots.txt "Disallow: /" plus an X-Robots-Tag: noindex header.
NEXT_PUBLIC_ENABLE_INDEXING=false

# Shared with the backend (same value in its REVALIDATE_SECRET). The backend
# sends it on POST /api/revalidate after an admin write so the cache for what
# changed is dropped and rebuilt straight away. Server-only — never expose it.
REVALIDATE_SECRET=
